{
  "name": "maika",
  "private": true,
  "version": "0.1.0",
  "description": "MAIKA — tienda y experiencia web",
  "author": "MAIKA",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "app": "concurrently -k -n front,api,desk -c blue,magenta,green \"npm run dev\" \"npm run backend:dev\" \"wait-on http://127.0.0.1:5173 tcp:127.0.0.1:3001 && electron .\"",
    "dev:full": "concurrently -n front,api -c blue,magenta \"npm run dev\" \"npm run backend:dev\"",
    "dev:mobile": "vite --host",
    "build": "tsc -b && vite build",
    "predist": "node scripts/gen-icon-ico.mjs && npm run build",
    "dist": "electron-builder --win",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "backend:dev": "node backend/server.js",
    "test:backend": "vitest run --config backend/vitest.config.js && node --test backend/utils/usuarioPayload.test.js backend/tests/productoPublico.test.js",
    "sync-logo": "node scripts/sync-logo-to-iconos.mjs",
    "backup:data": "node scripts/backup-data.mjs",
    "reset:usuarios": "node scripts/reset-usuarios.mjs",
    "dedupe:usuarios-telefono": "node backend/scripts/fusionarUsuariosDuplicadosPorTelefono.mjs",
    "android:sync": "node scripts/write-capacitor-config.mjs --packaged && npm run build && npx cap sync android",
    "android:live:sync": "node scripts/write-capacitor-config.mjs && npx cap sync android",
    "android:dev": "node scripts/write-capacitor-config.mjs && npx cap sync android && npx cap open android",
    "android:open": "npx cap open android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@emailjs/browser": "^4.4.1",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dompurify": "^3.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.1.0",
    "@eslint/js": "^9.39.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "png-to-ico": "^3.0.1",
    "supertest": "^7.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.5"
  }
}
