# Copia este archivo a `.env` en la raíz del proyecto y rellena los valores.
# En PowerShell NO uses el nombre de la variable como comando; el .env lo lee Node con dotenv.

OPENAI_API_KEY=
# Sueño (texto): interpretar/seguimiento/chat usan DeepSeek si esta clave está definida; si no, caen a OPENAI_API_KEY.
# La generación de imagen del sueño (DALL·E 3) siempre usa OPENAI_API_KEY (DeepSeek no genera imágenes).
DEEPSEEK_API_KEY=

# Seguridad backend: en producción son obligatorias.
# Usa valores largos y distintos. No compartas este archivo si contiene secretos reales.
JWT_SECRET=
# Duración del JWT de usuario (login). Ej.: 12h, 1d, 7d. Por defecto 1d.
# JWT_CLIENT_EXPIRES_IN=1d
MAIKA_ADMIN_PANEL_PASSWORD=
MAIKA_PREMIUM_JWT_SECRET=
FRONTEND_URL=http://localhost:5173
# Opcional: varios orígenes CORS separados por coma (staging, app móvil). Si vacío, solo FRONTEND_URL.
# En desarrollo, sin esta variable, también se aceptan orígenes tipo http://192.168.x.x:5173 (Vite en la LAN).
# MAIKA_CORS_ORIGINS=http://localhost:5173,https://tu-dominio.com
# Si Vite no usa 5173: MAIKA_DEV_VITE_PORT=5174

# Opcional: enlace wa.me para el pie del correo de recuperación de contraseña (soporte).
# Ejemplo: https://wa.me/34612345678 (prefijo del país sin +)
# WHATSAPP_URL=

# Email backend para recuperación de contraseña.
# Gmail requiere App Password, no la contraseña normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Opcional: destinatario para POST /test-email. Si se deja vacío, usa SMTP_USER.
SMTP_TEST_TO=
# SMTP_SECURE=true solo si usas puerto 465.
# SMTP_SECURE=false
# Solo si tu proveedor SMTP da problemas de certificados en desarrollo.
# No lo actives en producción salvo que sepas exactamente por qué.
# SMTP_ALLOW_INVALID_TLS=true

# Opcional: depurar sin imprimir la clave en consola
# DEBUG_OPENAI_KEY=1

# Solo desarrollo: permite POST /sueno/seguimiento sin token (omitir gate premium).
# MAIKA_PREMIUM_SKIP_GATE=1

